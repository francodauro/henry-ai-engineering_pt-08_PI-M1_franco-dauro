# Copiá este archivo como ".env" y completá tus claves.
# El .env NUNCA se sube al repo (está en .gitignore). Este archivo sí: no tiene valores reales.
# Todas las variables menos las claves tienen un valor por defecto en src/config.py: si una queda
# vacía, se usa ese valor. Acá se muestran los valores por defecto y el motivo de cada uno.

# --- Proveedor primario (gratuito): Google Gemini ---
# Clave en https://aistudio.google.com (botón "Get API key"). No actives facturación en ese proyecto:
# así queda en el plan gratuito y nunca cobra.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Tope de tokens de salida. Más alto que el de OpenAI porque Gemini puede "pensar" antes de responder
# y esos tokens cuentan contra este límite.
GEMINI_MAX_TOKENS=1024

# --- Proveedor de respaldo (pago): OpenAI ---
# Clave en https://platform.openai.com/api-keys
OPENAI_API_KEY=
# gpt-6-luna: USD 0.10 por 1M de tokens de entrada y USD 0.50 por 1M de salida (config/pricing.json).
OPENAI_MODEL=gpt-6-luna
# Tope de tokens de salida: una respuesta de soporte entra holgada en 400 y limita el costo por llamada.
OPENAI_MAX_TOKENS=400
# gpt-6-luna es un modelo de razonamiento: "none" lo hace responder sin razonar (más rápido y barato).
OPENAI_REASONING_EFFORT=none

# --- Orden de proveedores: el primero es el primario, el segundo el respaldo ---
LLM_PROVIDER_ORDER=gemini,openai

# --- Comportamiento de la llamada ---
# 0 = la respuesta más probable: la misma consulta recibe siempre la misma respuesta (clasificar no es creativo).
LLM_TEMPERATURE=0.0

# --- Reintentos ante errores transitorios (429, 5xx, timeout, red) ---
# Reintentos además del primer intento, con espera de 1 s, 2 s… más un extra al azar (jitter).
LLM_MAX_RETRIES=2
# Si el servidor pide esperar (Retry-After) más que esto, no se espera: se pasa al respaldo.
LLM_MAX_WAIT_SECONDS=10
# Tiempo máximo de espera de cada llamada.
LLM_TIMEOUT_SECONDS=30

# --- Tope de gasto en USD del proveedor pago, sumando data/metrics.jsonl ---
# Al llegar al tope, OpenAI no se llama más. Objetivo del alumno: menos de USD 5 en todo el curso.
BUDGET_USD=4.50
