# Copiá este archivo como ".env" y completá tus claves.
# El .env NUNCA se sube al repo (está en .gitignore). Este archivo sí: no tiene valores reales.

# --- Proveedor primario (gratuito): Google Gemini ---
# Clave en https://aistudio.google.com (botón "Get API key"). No actives facturación en ese proyecto.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Proveedor de respaldo (pago): OpenAI ---
# Clave en https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# --- Orden de proveedores: el primero es el primario, el segundo el respaldo ---
LLM_PROVIDER_ORDER=gemini,openai
